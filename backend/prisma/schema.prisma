generator client {
  provider = "prisma-client-js"
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  displayName  String
  passwordHash String
  role         Role            @default(reader)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resets       PasswordReset[]
}

model AuthorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  displayName String?
  bio         String?
  website     String?
  photoUrl    String?
  instagram   String?
  twitter     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  books Book[]
}

model Book {
  id            String         @id @default(cuid())
  authorId      String
  title         String
  subtitle      String?
  blurb         String?
  status        BookStatus     @default(draft)
  genreId       String?
  language      String?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  coverUrl      String?

  author        AuthorProfile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  genre         Genre?         @relation(fields: [genreId], references: [id])
  sections      BookSection[]
  tags          BookTag[]
  purchaseLinks PurchaseLink[]
}

model BookSection {
  id         String   @id @default(cuid())
  bookId     String
  title      String?
  content    String
  orderIndex Int
  isPreview  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, orderIndex])
}

model PurchaseLink {
  id        String   @id @default(cuid())
  bookId    String
  label     String
  url       String
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  books BookTag[]
}

model BookTag {
  bookId String
  tagId  String

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([bookId, tagId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Role {
  reader
  author
  admin
}

enum BookStatus {
  draft
  an_idea
  unedited
  edited
  to_publish
  published
  paused
}